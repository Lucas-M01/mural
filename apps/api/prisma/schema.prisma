generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String   @id @default(uuid())
  googleId              String   @unique
  email                 String   @unique
  name                  String
  avatarUrl             String?
  expoPushToken         String?
  googleRefreshTokenEnc String? // criptografado
  createdAt             DateTime @default(now())

  ownedLists    List[]       @relation("ListOwner")
  memberships   ListMember[]
  createdTasks  Task[]       @relation("TaskCreator")
  assignedTasks Task[]       @relation("TaskAssignee")
}

model List {
  id        String       @id @default(uuid())
  title     String
  color     String       @default("#FFFFFF")
  isShared  Boolean      @default(false)
  ownerId   String
  owner     User         @relation("ListOwner", fields: [ownerId], references: [id])
  members   ListMember[]
  tasks     Task[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId])
}

model ListMember {
  listId String
  userId String
  role   ListRole @default(MEMBER)
  list   List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
  @@index([userId])
}

enum ListRole {
  OWNER
  MEMBER
}

model Task {
  id            String    @id @default(uuid())
  listId        String
  title         String
  notes         String?
  isChecked     Boolean   @default(false)
  priority      Priority  @default(MEDIUM)
  position      Int       @default(0) // ordenação drag-and-drop
  dueDate       DateTime?
  reminderAt    DateTime?
  googleEventId String?
  createdById   String
  assignedToId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // soft delete (necessário para sync offline)

  list       List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy  User  @relation("TaskCreator", fields: [createdById], references: [id])
  assignedTo User? @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@index([listId, position])
  @@index([listId, updatedAt])
  @@index([createdById])
  @@index([assignedToId])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
